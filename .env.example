# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Interactive Brokers TWS/Gateway connection
# Make sure TWS or IB Gateway is running with API connections enabled
IB_HOST=127.0.0.1
IB_PORT=7497          # 7496=live trading, 7497=paper trading
IB_CLIENT_ID=1

# Safety flag — set to true when using a paper trading account.
# If PAPER_TRADING=true but IB_PORT=7496, the agent will warn you loudly.
PAPER_TRADING=true

# Comma-separated list of stock symbols to trade
WATCH_LIST=AAPL,MSFT,GOOGL,AMZN,NVDA

# How often the agent runs (in seconds)
AGENT_INTERVAL_SECONDS=300

# Maximum portfolio allocation per position (0.1 = 10%)
MAX_POSITION_SIZE_PCT=0.1

# ── TELEGRAM NOTIFICATIONS (optional) ────────────────────────────────────────
# Receive a push notification on every trade, cycle summary, startup, and error.
#
# Setup:
#   1. Message @BotFather on Telegram → /newbot → copy the token
#   2. Start a chat with your bot (just say hi to it)
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates in your browser
#      Find "chat":{"id": 123456789} — that number is your TELEGRAM_CHAT_ID
#   4. Fill in both values below and restart the agent
#
# Leave blank (or omit) to disable notifications entirely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ─────────────────────────────────────────────────────────────────────────────

# ── GOING LIVE ──────────────────────────────────────────────────────────────
# To trade real money, change these two settings:
#
#   IB_PORT=7496        ← live trading port (default above is 7497 paper)
#   PAPER_TRADING=false ← disables paper-trading safety mode
#
# IMPORTANT: changing this file alone is NOT enough.
# You must ALSO switch IB Gateway / TWS itself to Live Trading:
#
#   IB Gateway : select "Live Trading" on the login screen (not Paper Trading)
#   TWS        : the account shown top-right must be your live account number
#
# In IB Gateway settings → API → Settings:
#   - Enable ActiveX and Socket Clients: ON
#   - Socket port: 7496
#   - Trusted IP: 127.0.0.1
#
# Only when BOTH the app AND this file are in live mode will real orders execute.
# ────────────────────────────────────────────────────────────────────────────
